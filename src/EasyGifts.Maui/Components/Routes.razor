<CascadingAuthenticationState>
    <Router AppAssembly="typeof(MauiProgram).Assembly" AdditionalAssemblies="new[] { typeof(EasyGifts.UI.Components.Home).Assembly }">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(EasyGifts.UI.Components.Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="routeData" Selector="h1" />
        </Found>
        <NotFound>
            <LayoutView Layout="typeof(EasyGifts.UI.Components.Layout.MainLayout)">
                <p>Page non trouvée</p>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
